clc;
clear;
close all;

%% Data
slices = {'eMBB','URLLC','mMTC','Private','IoT'};

count = [1 1 1 1 1];
utilization = [85 70 60 75 50];
latency = [25 5 40 15 60];

%% Single Figure with 3 Outputs
figure;

% Output 1: Number of Configured Network Slices
subplot(1,3,1);
bar(count);
grid on;
set(gca,'XTick',1:5);
set(gca,'XTickLabel',slices);
xlabel('Network Slice Type');
ylabel('Number of Slices');
title('Configured 5G Network Slices');

% Output 2: Slice Utilization
subplot(1,3,2);
bar(categorical(slices), utilization);
grid on;
xlabel('Network Slice Type');
ylabel('Utilization (%)');
title('5G Slice Utilization');
ylim([0 100]);

% Output 3: End-to-End Latency
subplot(1,3,3);
plot(1:5, latency, '-o', 'LineWidth', 2, 'MarkerSize', 7);
grid on;
xticks(1:5);
xticklabels(slices);
xlabel('Network Slice Type');
ylabel('Latency (ms)');
title('5G End-to-End Latency');
ylim([0 70]);
