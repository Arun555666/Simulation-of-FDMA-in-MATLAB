clc;
clear;
close all;

%% Data
snr = 0:5:30;
snr_linear = 10.^(snr/10);
capacity = log2(1 + snr_linear);

antennas = [4 8 16 32 64];
gain = 10*log10(antennas);

%% Single Figure with 3 Outputs
figure;

% Output 1: Channel Capacity
subplot(1,3,1);
plot(snr, capacity, '-o', 'LineWidth', 2, 'MarkerSize', 5);
grid on;
xlabel('SNR (dB)');
ylabel('Capacity (bps/Hz)');
title('Channel Capacity');

% Output 2: SNR Comparison
subplot(1,3,2);
plot(snr, capacity, '-o', 'LineWidth', 2, 'MarkerSize', 5);
grid on;
xlabel('SNR (dB)');
ylabel('Capacity (bps/Hz)');
title('SNR Comparison');

% Output 3: Antenna Gain
subplot(1,3,3);
bar(antennas, gain);
grid on;
xlabel('Antenna Elements');
ylabel('Gain (dB)');
title('Antenna Gain');
